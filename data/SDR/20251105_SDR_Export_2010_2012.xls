gn:left;'></td><td style='white-space:nowrap;text-align:left;'>EXHAUST VALVE</td><td style='white-space:nowrap;text-align:left;'>SL17540</td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'>SHEARED</td><td style='white-space:nowrap;text-align:left;'>CYLINDER</td><td style='white-space:nowrap;text-align:left;'>1120</td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'>CYLINDER</td><td style='white-space:nowrap;text-align:left;'>LW12416</td><td style='white-space:nowrap;text-align:left;'>119</td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-space:nowrap;text-align:left;'></td><td style='white-spa